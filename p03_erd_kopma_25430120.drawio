&amp;nbsp;|&amp;nbsp;&amp;nbsp;0..1 = nol atau satu&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;0..N = nol atau banyak&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;1..N = satu atau banyak&lt;br/&gt;&lt;i&gt;Simbol dekat kotak entitas = maksimum, simbol lebih jauh = minimum. Garis ditarik dari kunci primer ke kunci tamu.&lt;/i&gt;" style="rounded=1;arcSize=6;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=11;strokeColor=#78829a;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="900" width="1180" height="82" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>